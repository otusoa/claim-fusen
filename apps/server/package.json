{
  "name": "@kari-fusen/server",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @kari-fusen/schemas build && tsx watch --env-file=../../.env src/index.ts",
    "build": "pnpm --filter @kari-fusen/schemas build && tsc",
    "start": "node dist/index.js",
    "typecheck": "pnpm --filter @kari-fusen/schemas build && tsc --noEmit",
    "db:generate": "pnpm --filter @kari-fusen/schemas build && drizzle-kit generate",
    "db:check": "pnpm --filter @kari-fusen/schemas build && drizzle-kit check",
    "db:migrate": "pnpm --filter @kari-fusen/schemas build && drizzle-kit migrate"
  },
  "dependencies": {
    "@kari-fusen/schemas": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}