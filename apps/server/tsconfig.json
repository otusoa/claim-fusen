{
  "extends": "nitro/tsconfig",
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"],
      "~~/*": ["./*"]
    },
    "types": [
      "node"
    ]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "nitro.config.ts", "vitest.config.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", ".output"]
}
