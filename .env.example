# ローカル開発用。パスワードは自分の.envで変更する。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=claim_fusen
POSTGRES_PORT=5432
BACKEND_PORT=8080

# ホスト上でGoを実行するときの接続先。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claim_fusen?sslmode=disable

# Compose内ではサービス名dbを使う。認証情報は上記の設定に合わせる。
COMPOSE_DATABASE_URL=postgresql://postgres:postgres@db:5432/claim_fusen?sslmode=disable
